# Linux CPU environment for source-based CLI runs, including Intel Macs.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLBACKEND=Agg

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg espeak-ng libsndfile1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && python -m pip check

# TorchCodec's binary interface must match torch 2.8, even though the
# upstream requirements only specify torchcodec>=0.7.0 transitively.
RUN python -m pip install --no-cache-dir torchcodec==0.7.0 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip check

WORKDIR /work
CMD ["python", "-m", "src.eval", "input_sample_scores"]
